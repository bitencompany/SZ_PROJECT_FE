# 인증은 FE 서버에서만 처리합니다. 실제 값은 .env.local에 입력하세요.
APP_URL=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SAZU_API_KEY는 BE에만 설정합니다. 이 프로젝트에는 복사하지 마세요.
BACKEND_API_URL=http://127.0.0.1:3017
# BE와 동일한 32바이트 이상의 무작위 서버 비밀. NEXT_PUBLIC_ 금지.
BFF_SHARED_SECRET=
# Vercel 배포에서 신뢰 IP 전달을 검증한 뒤 vercel로 설정합니다.
# 미설정 시 차단합니다. 로컬 무료 샘플 검증은 local로 설정할 수 있습니다.
# local은 NODE_ENV=development, FE/BE URL이 모두 http://127.0.0.1일 때만 허용합니다.
PREVIEW_IP_SOURCE=disabled
# BE의 검수 카탈로그 반입과 /api/hanja, /api/name 계약 검증 후 true로 변경합니다.
# false일 때는 검수되지 않은 예시 한자 데이터임을 화면에 표시합니다.
BACKEND_NAME_ENABLED=false
